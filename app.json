{
  "expo": {
    "name": "Habbits Line",
    "slug": "habbits-line",
    "version": "1.0.0",
    "description": "An offline habit and expense tracker: streaks, a budget per period and statistics. No accounts, no network, everything stays on the device.",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habbitsline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dastan.habbitsline",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0F0D17",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e666b010-3d01-42c9-8fa4-f5ca82dab8bd"
      }
    },
    "owner": "dastanl"
  }
}
